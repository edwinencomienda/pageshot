{
  "manifest_version": 3,
  "name": "PageShot",
  "version": "1.0.0",
  "description": "Capture webpages as PNGs and download or copy them to the clipboard.",
  "permissions": ["activeTab", "downloads", "scripting", "clipboardWrite"],
  "incognito": "split",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Take a full-page screenshot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
